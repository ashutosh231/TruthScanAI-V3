# Environment & Deployment Mode
NODE_ENV=production
DJANGO_SECRET_KEY=your_strong_django_secret_key_here

# Frontend Client URL (for CORS and CSRF, comma-separated if multiple)
CLIENT_URL=https://your-truthscan-frontend.vercel.app,http://localhost:3000

# Database (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Redis Cache & Rate-Limiting (e.g. Upstash Redis or Render Redis)
REDIS_URL=rediss://default:<password>@<host>:<port>

# Authentication (JWT Secrets)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Email Service: Brevo HTTPS API (Recommended for Render Free Tier - Port 443) OR SMTP
BREVO_API_KEY=xkeysib-your_brevo_v3_api_key
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login_email
SMTP_PASS=your_smtp_master_password
FROM_EMAIL=no-reply@truthscan.ai
FROM_NAME=TruthScan AI

# Cloud Storage (Cloudinary for avatar & document uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Models (AWS Bedrock DeepSeek / Claude)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
BEDROCK_MODEL_ID=deepseek.v3.2

# Real-Time Fact-Checking Web Search (Tavily AI)
TAVILY_API_KEY=tvly-your_tavily_api_key

# News Intelligence API
NEWSAPI_AI_KEY=your_newsapi_ai_key

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
